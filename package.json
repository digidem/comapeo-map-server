{
	"name": "@comapeo/map-server",
	"version": "2.0.1",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./errors.js": {
			"types": "./dist/lib/errors.d.ts",
			"default": "./dist/lib/errors.js"
		},
		"./constants.js": {
			"types": "./dist/lib/constants.d.ts",
			"default": "./dist/lib/constants.js"
		}
	},
	"scripts": {
		"test": "run-p test:*",
		"bench": "vitest bench --run",
		"test:js": "vitest run",
		"test:lint": "eslint",
		"test:types": "tsc --noEmit",
		"publint": "npm run build && publint",
		"format": "prettier --write .",
		"prepare": "husky && patch-package",
		"build": "tsc -p tsconfig.npm.json",
		"prepack": "run-s test build"
	},
	"keywords": [],
	"author": "Awana Digital",
	"license": "MIT",
	"description": "Map Style & Tile server for CoMapeo",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@tsconfig/node22": "^22.0.6",
		"@types/bogon": "^1.0.2",
		"@types/node": "^22.20.1",
		"@vitest/coverage-v8": "^4.1.11",
		"bogon": "^1.3.0",
		"eslint": "^10.9.1",
		"eventsource-client": "^1.2.0",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"ky": "^2.1.0",
		"lint-staged": "^17.4.1",
		"msw": "^2.15.0",
		"npm-run-all2": "^9.0.3",
		"patch-package": "^8.0.1",
		"prettier": "^3.9.6",
		"publint": "^0.3.24",
		"type-fest": "^5.9.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0",
		"vitest": "^4.1.11"
	},
	"prettier": {
		"semi": false,
		"singleQuote": true,
		"useTabs": true,
		"importOrderSeparation": true,
		"importOrder": [
			"^node:",
			"^@?\\w",
			"^[./]"
		],
		"plugins": [
			"@trivago/prettier-plugin-sort-imports"
		]
	},
	"lint-staged": {
		"*.js": "eslint --cache --fix",
		"*.{js,css,md}": "prettier --write"
	},
	"dependencies": {
		"@mapbox/mapbox-gl-style-spec": "^14.29.1",
		"@maplibre/maplibre-gl-style-spec": "^26.4.1",
		"@whatwg-node/server": "^0.11.0",
		"itty-router": "^5.0.24",
		"p-defer": "^4.0.1",
		"p-mutex": "^1.0.0",
		"secret-stream-http": "^2.0.0",
		"smp-noto-glyphs": "^1.0.0",
		"start-stop-state-machine": "^2.0.0",
		"styled-map-package-api": "^5.0.0",
		"typebox": "^1.3.25",
		"typed-event-target": "^4.3.3"
	},
	"bundleDependencies": [
		"@whatwg-node/server"
	],
	"files": [
		"src/",
		"dist/"
	],
	"directories": {
		"test": "test"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/digidem/comapeo-map-server.git"
	},
	"bugs": {
		"url": "https://github.com/digidem/comapeo-map-server/issues"
	},
	"homepage": "https://github.com/digidem/comapeo-map-server#readme"
}
